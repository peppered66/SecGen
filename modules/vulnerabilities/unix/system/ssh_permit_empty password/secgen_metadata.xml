<?xml version="1.0"?>

<vulnerability xmlns="http://www.github/cliffe/SecGen/vulnerability"
               xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
               xsi:schemaLocation="http://www.github/cliffe/SecGen/vulnerability">

  <name>Access control mis-configurations SSH empty password login</name>
  <author>William Smith</author>
  <module_license>Apache v2</module_license>

  <description>
    Misconfigure SSH to allow authentication using empty passwords. When combined
    with an account that has no password set, this enables unauthenticated remote
    access to the system, providing an initial foothold for further exploitation.
  </description>

  <type>access_control_misconfiguration</type>
  <type>ssh_empty_password_login</type>
  <privilege>user_rwx</privilege>
  <access>remote</access>
  <platform>unix</platform>


  <requires>
    <module_path>utilities/unix/puppet_module/ssh</module_path>
  </requires>

  <CyBOK KA="AAA" topic="Authorisation">
    <keyword>authentication</keyword>
    <keyword>access control</keyword>
    <keyword>misconfiguration</keyword>
    <keyword>unauthenticated access</keyword>
  </CyBOK>

  <CyBOK KA="OSV" topic="Primitives for Isolation and Mediation">
    <keyword>Linux authentication</keyword>
    <keyword>SSH security</keyword>
    <keyword>remote access</keyword>
    <keyword>credential bypass</keyword>
  </CyBOK>

</vulnerability>