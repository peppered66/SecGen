<?xml version="1.0"?>

<scenario xmlns="http://www.github/cliffe/SecGen/scenario"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://www.github/cliffe/SecGen/scenario">

  <name>sudo_root_tee test: Debian 12 KDE</name>
  <author>William Smith</author>
  <description>
    Provisions a Debian 12 KDE VM with a standard user account and a sudo misconfiguration
    allowing privilege escalation via tee.
  </description>

  <type>ctf</type>
  <difficulty>easy</difficulty>

  <system>
    <system_name>target_vm</system_name>

    <base distro="Debian 12" type="desktop" name="KDE"/>

    <!-- Create test user with login credentials -->
    <utility module_path=".*/parameterised_accounts">
      <input into="accounts">
        <value>
          {"username":"testuser","password":"test123","super_user":"false","strings_to_leak":[],"leaked_filenames":[]}
        </value>
      </input>
    </utility>

    <!-- Vulnerability module -->
    <vulnerability module_path=".*sudo_root_tee.*">

      <input into="strings_to_leak">
        <generator type="flag_generator"/>
      </input>

      <input into="leaked_filenames">
        <generator type="filename_generator"/>
      </input>

    </vulnerability>

    <network type="private_network"/>

  </system>

</scenario>